<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>The Simpsons Episode Ratings Tracker (Seasons 1–12)</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts: Inter & Luckiest Guy for cartoon branding -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Luckiest+Guy&display=swap" rel="stylesheet">
  
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            simpson: {
              yellow: '#FED90F',
              yellowDark: '#E5C000',
              blue: '#70D6FF',
              blueSky: '#3A86FF',
              donut: '#FF69B4',
              donutDark: '#E84A86',
              bgLight: '#FFFBE6'
            }
          },
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
            simpson: ['"Luckiest Guy"', 'cursive']
          }
        }
      }
    }
  </script>

  <style>
    /* Custom scrollbars */
    ::-webkit-scrollbar {
      height: 8px;
      width: 8px;
    }
    ::-webkit-scrollbar-track {
      background: #FEE765;
      border-radius: 4px;
    }
    ::-webkit-scrollbar-thumb {
      background: #D9A800;
      border-radius: 4px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #B38600;
    }

    /* Range slider custom styling for integer steps */
    input[type=range] {
      -webkit-appearance: none;
      width: 100%;
      background: transparent;
    }
    input[type=range]:focus {
      outline: none;
    }
    input[type=range]::-webkit-slider-thumb {
      -webkit-appearance: none;
      height: 26px;
      width: 26px;
      border-radius: 50%;
      background: #FED90F;
      border: 3px solid #111827;
      cursor: pointer;
      margin-top: -9px;
      box-shadow: 0 2px 6px rgba(0,0,0,0.3);
      transition: transform 0.1s ease;
    }
    input[type=range]::-webkit-slider-thumb:hover {
      transform: scale(1.18);
    }
    input[type=range]::-webkit-slider-runnable-track {
      width: 100%;
      height: 9px;
      cursor: pointer;
      border-radius: 9999px;
      background: #E5E7EB;
      border: 1.5px solid #111827;
    }

    /* Diagonal split triangle pattern for dual rating display */
    .diagonal-cell {
      position: relative;
      overflow: hidden;
    }
    .diagonal-cell .top-left {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      clip-path: polygon(0 0, 100% 0, 0 100%);
    }
    .diagonal-cell .bottom-right {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      clip-path: polygon(100% 0, 100% 100%, 0 100%);
    }

    /* Springfield cloud background banner */
    .springfield-clouds {
      background: radial-gradient(circle at 10% 20%, rgba(255,255,255,0.7) 0%, transparent 20%),
                  radial-gradient(circle at 35% 60%, rgba(255,255,255,0.8) 0%, transparent 25%),
                  radial-gradient(circle at 75% 25%, rgba(255,255,255,0.75) 0%, transparent 22%),
                  radial-gradient(circle at 90% 70%, rgba(255,255,255,0.85) 0%, transparent 28%);
    }
  </style>
</head>

<body class="bg-[#FDE74C] text-gray-900 min-h-screen font-sans selection:bg-pink-300 selection:text-gray-900 pb-16">

  <!-- Header Banner -->
  <header class="bg-[#FED90F] border-b-4 border-black shadow-md relative overflow-hidden">
    <div class="absolute inset-0 bg-blue-300/30 springfield-clouds pointer-events-none"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-5 relative z-10 flex flex-col md:flex-row items-center justify-between gap-4">
      
      <!-- Brand & Title -->
      <div class="flex items-center gap-3">
        <div class="w-12 h-12 rounded-full bg-pink-400 border-2 border-black flex items-center justify-center shadow-md text-2xl flex-shrink-0 animate-bounce">
          🍩
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h1 class="text-3xl sm:text-4xl font-simpson tracking-wider text-black drop-shadow-[2px_2px_0px_#ffffff]">
              THE SIMPSONS
            </h1>
            <span class="bg-black text-[#FED90F] text-xs font-black uppercase px-2.5 py-0.5 rounded tracking-wider">
              Ratings Tracker
            </span>
          </div>
          <p class="text-xs sm:text-sm font-semibold text-gray-800 tracking-tight">
            Golden Age (Seasons 1–12) • Quality & Hilarity Scorecard
          </p>
        </div>
      </div>

      <!-- Live User Stats Badges -->
      <div class="flex flex-wrap items-center justify-center gap-2 text-xs">
        <div class="bg-white border-2 border-black rounded-xl px-3.5 py-1.5 shadow-sm text-center">
          <span class="block text-[10px] uppercase font-bold text-gray-500">Rated</span>
          <span id="stat-rated-count" class="font-extrabold text-sm text-gray-900">0 / 269</span>
        </div>
        <div class="bg-white border-2 border-black rounded-xl px-3.5 py-1.5 shadow-sm text-center">
          <span class="block text-[10px] uppercase font-bold text-gray-500">My Avg Quality</span>
          <span id="stat-avg-quality" class="font-extrabold text-sm text-emerald-700">-</span>
        </div>
        <div class="bg-white border-2 border-black rounded-xl px-3.5 py-1.5 shadow-sm text-center">
          <span class="block text-[10px] uppercase font-bold text-gray-500">My Avg Hilarity</span>
          <span id="stat-avg-hilarity" class="font-extrabold text-sm text-blue-700">-</span>
        </div>
      </div>
    </div>
  </header>

  <main class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 mt-5">
    
    <!-- Tab Controls Bar -->
    <div class="flex items-center justify-between border-b-2 border-black pb-2 mb-6">
      <div class="flex gap-2">
        <button id="tab-btn-entry" onclick="switchTab('entry')" 
          class="flex items-center gap-2 px-5 py-2.5 rounded-t-xl font-bold text-sm sm:text-base border-2 border-b-0 border-black transition-all bg-white text-black shadow-md -mb-[2px] relative z-10">
          <svg class="w-5 h-5 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
          </svg>
          1. Data Entry
        </button>

        <button id="tab-btn-chart" onclick="switchTab('chart')" 
          class="flex items-center gap-2 px-5 py-2.5 rounded-t-xl font-bold text-sm sm:text-base border-2 border-b-0 border-black/40 transition-all bg-amber-200/70 hover:bg-white/70 text-gray-700 -mb-[2px]">
          <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
          </svg>
          2. Ratings Chart
        </button>
      </div>

      <!-- Quick Export / Import tools -->
      <div class="hidden sm:flex items-center gap-2">
        <button onclick="exportCSV()" title="Download your personal ratings as CSV" class="px-3 py-1.5 text-xs font-black bg-emerald-700 hover:bg-emerald-800 text-white rounded-lg border-2 border-black shadow-sm transition-all flex items-center gap-1.5">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
          Export CSV
        </button>
      </div>
    </div>

    <!-- TAB 1: DATA ENTRY -->
    <section id="view-entry" class="block">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        
        <!-- Main Form Card -->
        <div class="lg:col-span-8 bg-white border-3 border-black rounded-2xl shadow-[5px_5px_0px_#000000] p-6 sm:p-8">
          
          <div class="flex items-center justify-between pb-4 border-b border-gray-200 mb-6">
            <div>
              <h2 class="text-2xl font-black text-gray-900 tracking-tight flex items-center gap-2">
                Rate Episode
              </h2>
              <p class="text-xs text-gray-500 font-medium">Assign whole integer scores (1 to 10) for Quality and Hilarity.</p>
            </div>
            
            <!-- Rated/Unrated Badge Indicator -->
            <div id="current-rating-badge" class="px-3 py-1 rounded-full text-xs font-black border border-gray-300 bg-gray-100 text-gray-600 transition-colors">
              Unrated
            </div>
          </div>

          <!-- INPUTS 1 & 2: Season & Episode Dropdowns -->
          <div class="grid grid-cols-1 sm:grid-cols-12 gap-4 mb-6">
            
            <!-- 1. Season Dropdown -->
            <div class="sm:col-span-4">
              <label for="select-season" class="block text-xs font-extrabold uppercase text-gray-700 tracking-wider mb-1.5">
                1. Season (1–12)
              </label>
              <div class="relative">
                <select id="select-season" onchange="onSeasonChange()" 
                  class="w-full appearance-none bg-yellow-50 border-2 border-black rounded-xl px-4 py-3 font-bold text-gray-900 focus:outline-none focus:ring-2 focus:ring-yellow-400 focus:border-black cursor-pointer shadow-sm text-sm">
                  <!-- Seasons 1 to 12 generated via JS -->
                </select>
                <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-black">
                  ▼
                </div>
              </div>
            </div>

            <!-- 2. Episode Dropdown -->
            <div class="sm:col-span-8">
              <label for="select-episode" class="block text-xs font-extrabold uppercase text-gray-700 tracking-wider mb-1.5 flex justify-between">
                <span>2. Episode Number & Title</span>
                <span id="season-ep-count-hint" class="text-gray-500 font-medium lowercase"></span>
              </label>
              <div class="relative">
                <select id="select-episode" onchange="onEpisodeChange()" 
                  class="w-full appearance-none bg-yellow-50 border-2 border-black rounded-xl px-4 py-3 font-bold text-gray-900 focus:outline-none focus:ring-2 focus:ring-yellow-400 focus:border-black cursor-pointer shadow-sm text-sm truncate">
                  <!-- Episodes generated dynamically -->
                </select>
                <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-black">
                  ▼
                </div>
              </div>
            </div>
          </div>

          <!-- Episode Info & Prev/Next Quick Navigation -->
          <div class="bg-amber-50/90 border-2 border-dashed border-amber-300 rounded-xl p-4 mb-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
            <div>
              <span id="preview-tag" class="inline-block bg-yellow-400 text-black text-[11px] font-black px-2.5 py-0.5 rounded uppercase tracking-wider mb-1">
                Season 1 • Episode 1
              </span>
              <h3 id="preview-title" class="text-lg font-extrabold text-gray-900">
                Simpsons Roasting on an Open Fire
              </h3>
            </div>
            
            <!-- Quick Prev/Next buttons -->
            <div class="flex items-center gap-2 self-end sm:self-center">
              <button onclick="navEpisode(-1)" title="Previous Episode" class="px-3 py-2 rounded-xl border-2 border-black bg-white hover:bg-yellow-200 text-gray-900 font-bold transition-transform active:scale-95 shadow-sm text-xs flex items-center gap-1">
                ◀ Prev
              </button>
              <button onclick="navEpisode(1)" title="Next Episode" class="px-3 py-2 rounded-xl border-2 border-black bg-white hover:bg-yellow-200 text-gray-900 font-bold transition-transform active:scale-95 shadow-sm text-xs flex items-center gap-1">
                Next ▶
              </button>
            </div>
          </div>

          <!-- INPUTS 3 & 4: Integer Sliders (1 to 10) -->
          <div class="space-y-7">
            
            <!-- 3. Episode Quality Slider -->
            <div class="bg-gray-50 border-2 border-black rounded-xl p-5 shadow-sm">
              <div class="flex items-center justify-between mb-3">
                <div class="flex items-center gap-2">
                  <span class="w-3.5 h-3.5 rounded-full bg-emerald-600 inline-block"></span>
                  <label for="slider-quality" class="text-base font-extrabold text-gray-900">
                    3. Episode Quality (1–10)
                  </label>
                </div>
                
                <div id="badge-quality-val" class="w-12 h-10 rounded-lg flex items-center justify-center font-black text-xl border-2 border-black shadow-inner bg-emerald-500 text-white transition-colors">
                  7
                </div>
              </div>

              <!-- Strict Integer Step Range -->
              <input type="range" id="slider-quality" min="1" max="10" step="1" value="7"
                oninput="onQualitySliderInput(this.value)" class="w-full">
              
              <!-- Integer Ticks Guide -->
              <div class="flex justify-between text-[11px] font-black text-gray-500 mt-2 px-1">
                <span class="text-red-600">1</span>
                <span class="text-red-500">2</span>
                <span class="text-orange-500">3</span>
                <span class="text-orange-400">4</span>
                <span class="text-amber-500">5</span>
                <span class="text-yellow-600">6</span>
                <span class="text-emerald-500">7</span>
                <span class="text-emerald-600">8</span>
                <span class="text-emerald-700">9</span>
                <span class="text-emerald-800">10</span>
              </div>
            </div>

            <!-- 4. Episode Hilarity Slider -->
            <div class="bg-gray-50 border-2 border-black rounded-xl p-5 shadow-sm">
              <div class="flex items-center justify-between mb-3">
                <div class="flex items-center gap-2">
                  <span class="w-3.5 h-3.5 rounded-full bg-blue-600 inline-block"></span>
                  <label for="slider-hilarity" class="text-base font-extrabold text-gray-900">
                    4. Episode Hilarity (1–10)
                  </label>
                </div>
                
                <div id="badge-hilarity-val" class="w-12 h-10 rounded-lg flex items-center justify-center font-black text-xl border-2 border-black shadow-inner bg-blue-500 text-white transition-colors">
                  7
                </div>
              </div>

              <!-- Strict Integer Step Range -->
              <input type="range" id="slider-hilarity" min="1" max="10" step="1" value="7"
                oninput="onHilaritySliderInput(this.value)" class="w-full">
              
              <!-- Integer Ticks Guide -->
              <div class="flex justify-between text-[11px] font-black text-gray-500 mt-2 px-1">
                <span class="text-red-600">1</span>
                <span class="text-red-500">2</span>
                <span class="text-orange-500">3</span>
                <span class="text-orange-400">4</span>
                <span class="text-amber-500">5</span>
                <span class="text-yellow-600">6</span>
                <span class="text-emerald-500">7</span>
                <span class="text-emerald-600">8</span>
                <span class="text-emerald-700">9</span>
                <span class="text-emerald-800">10</span>
              </div>
            </div>
          </div>

          <!-- Action Buttons Bar -->
          <div class="mt-8 pt-6 border-t border-gray-200 flex flex-wrap items-center justify-between gap-3">
            <div class="flex items-center gap-2.5">
              <button onclick="saveCurrentRating()" 
                class="px-6 py-3 bg-[#FED90F] hover:bg-[#F0C900] active:scale-95 text-black font-extrabold text-base rounded-xl border-2 border-black shadow-[3px_3px_0px_#000] transition-all flex items-center gap-2">
                <svg class="w-5 h-5 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
                </svg>
                Save Rating
              </button>

              <button onclick="viewInChart()" 
                class="px-4 py-3 bg-white hover:bg-yellow-50 text-gray-800 font-bold text-sm rounded-xl border-2 border-black shadow-sm transition-all flex items-center gap-1.5">
                <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                </svg>
                View on Chart
              </button>
            </div>

            <button id="btn-delete-rating" onclick="clearCurrentRating()" 
              class="px-3.5 py-2.5 text-xs font-bold text-red-600 hover:text-white hover:bg-red-600 rounded-xl border border-red-300 transition-colors flex items-center gap-1">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
              </svg>
              Clear / Delete Rating
            </button>
          </div>

        </div>

        <!-- Sidebar: Season Progress Tracker -->
        <div class="lg:col-span-4 space-y-5">
          <!-- Current Season Progress Tracker -->
          <div class="bg-white border-3 border-black rounded-2xl p-6 shadow-[5px_5px_0px_#000]">
            <h4 class="text-xs font-black uppercase text-gray-800 tracking-wider mb-3 flex items-center justify-between">
              <span>Selected Season Progress</span>
              <span id="season-progress-label" class="text-amber-900 font-bold">0 / 13 rated</span>
            </h4>
            <div class="w-full bg-gray-100 border border-black rounded-full h-3.5 overflow-hidden mb-3">
              <div id="season-progress-bar" class="bg-emerald-500 h-full transition-all duration-300" style="width: 0%"></div>
            </div>
            <p class="text-xs text-gray-600 leading-snug">
              Every score is saved directly to your browser. You can export or backup your scores as a CSV anytime from the top bar.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- TAB 2: RATINGS CHART -->
    <section id="view-chart" class="hidden">
      
      <!-- Chart Controls Header -->
      <div class="bg-white border-3 border-black rounded-2xl shadow-[5px_5px_0px_#000] p-4 sm:p-6 mb-6">
        <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-4">
          
          <div>
            <h2 class="text-2xl font-black text-gray-900 tracking-tight flex items-center gap-2">
              <span>📊</span> Episode Ratings Matrix
            </h2>
            <p class="text-xs text-gray-500 font-medium">
              Season on top X-axis, Episode number on left Y-axis. Click any cell to jump to Data Entry.
            </p>
          </div>

          <!-- View Mode & CSV Action Buttons -->
          <div class="flex flex-wrap items-center gap-3">
            
            <!-- Cell Mode Control -->
            <div class="flex items-center bg-gray-100 p-1 rounded-xl border border-black">
              <button onclick="setChartDisplayMode('split')" id="mode-btn-split"
                class="px-3 py-1.5 rounded-lg text-xs font-black bg-white text-gray-900 shadow-sm border border-gray-300 transition-all">
                Dual Split (Q & H)
              </button>
              <button onclick="setChartDisplayMode('diagonal')" id="mode-btn-diagonal"
                class="px-3 py-1.5 rounded-lg text-xs font-bold text-gray-600 hover:text-gray-900 transition-all">
                Diagonal
              </button>
              <button onclick="setChartDisplayMode('quality')" id="mode-btn-quality"
                class="px-3 py-1.5 rounded-lg text-xs font-bold text-gray-600 hover:text-gray-900 transition-all">
                Quality Only
              </button>
              <button onclick="setChartDisplayMode('hilarity')" id="mode-btn-hilarity"
                class="px-3 py-1.5 rounded-lg text-xs font-bold text-gray-600 hover:text-gray-900 transition-all">
                Hilarity Only
              </button>
            </div>

            <!-- CSV & Reset Tools -->
            <div class="flex items-center gap-2">
              <button onclick="exportCSV()" class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg border border-black font-bold text-xs shadow-sm flex items-center gap-1">
                📥 Export CSV
              </button>
              <label class="px-3 py-1.5 bg-white hover:bg-gray-50 text-gray-800 rounded-lg border border-black font-bold text-xs shadow-sm cursor-pointer flex items-center gap-1">
                📤 Import CSV
                <input type="file" id="csv-file-input" accept=".csv" onchange="importCSV(event)" class="hidden">
              </label>
              <button onclick="promptClearAllRatings()" class="px-2.5 py-1.5 bg-red-100 hover:bg-red-200 text-red-800 rounded-lg border border-red-300 font-bold text-xs">
                Reset
              </button>
            </div>

          </div>
        </div>
      </div>

      <!-- The Yellow Grid Canvas -->
      <div class="bg-[#FED90F] border-3 border-black rounded-2xl shadow-[6px_6px_0px_#000] p-4 sm:p-6 overflow-x-auto relative">
        
        <!-- Header Caption -->
        <div class="text-center mb-5">
          <h3 class="text-lg sm:text-xl font-simpson tracking-wide text-black drop-shadow-[1px_1px_0px_#fff]">
            Your Average Rating per Season
          </h3>
          <p class="text-[11px] font-bold text-gray-800">
            Averages are calculated exclusively from your rated episodes. Unrated seasons show "-"
          </p>
        </div>

        <!-- Scrollable Chart Container -->
        <div class="min-w-[900px]">
          
          <!-- Top Row 1: Season Average Circles (Calculated Strictly From User Ratings) -->
          <div class="flex items-end mb-3">
            <div class="w-16 flex-shrink-0 text-center text-[10px] font-black uppercase text-gray-700">
              Avg:
            </div>
            <div class="grid grid-cols-12 flex-1 gap-1 text-center" id="season-avg-circles-row">
              <!-- Rendered via JS -->
            </div>
          </div>

          <!-- Top Row 2: Season Axis Header (Season 1 to 12) -->
          <div class="flex items-center mb-1">
            <div class="w-16 flex-shrink-0 text-center font-black text-xs text-gray-900 uppercase tracking-wider">
              Ep \ S
            </div>
            <div class="grid grid-cols-12 flex-1 gap-1 text-center font-black text-sm text-gray-900">
              <div class="py-1 bg-yellow-200/80 border border-black/40 rounded">1</div>
              <div class="py-1 bg-yellow-200/80 border border-black/40 rounded">2</div>
              <div class="py-1 bg-yellow-200/80 border border-black/40 rounded">3</div>
              <div class="py-1 bg-yellow-200/80 border border-black/40 rounded">4</div>
              <div class="py-1 bg-yellow-200/80 border border-black/40 rounded">5</div>
              <div class="py-1 bg-yellow-200/80 border border-black/40 rounded">6</div>
