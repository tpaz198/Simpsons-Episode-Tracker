    const STORAGE_KEY = 'simpsons_personal_ratings_v2_integers';
    let userRatings = {}; // Key format: "S_E" -> { quality: 8, hilarity: 9 }
    let currentSeason = 1;
    let currentEpisode = 1;
    let chartDisplayMode = 'split'; // 'split', 'diagonal', 'quality', 'hilarity'

    function loadRatingsFromStorage() {
      try {
        const stored = localStorage.getItem(STORAGE_KEY);
        if (stored) {
          userRatings = JSON.parse(stored);
        }
      } catch (err) {
        console.error("Failed to load ratings:", err);
        userRatings = {};
      }
    }

    function saveRatingsToStorage() {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(userRatings));
      } catch (err) {
        console.error("Failed to persist ratings:", err);
      }
    }

    // Color mapping for whole integers 1 to 10
    function getRatingColorTokens(score) {
      if (score === null || score === undefined || isNaN(score)) {
        return { bg: '#f1f5f9', text: '#94a3b8', border: '#cbd5e1' };
      }
      const val = Math.round(Number(score));
      if (val >= 9) {
        return { bg: '#15803d', text: '#ffffff', border: '#166534' };
      }
      if (val >= 7) {
        return { bg: '#86efac', text: '#064e3b', border: '#4ade80' };
      }
      if (val >= 5) {
        return { bg: '#facc15', text: '#713f12', border: '#eab308' };
      }
      return { bg: '#ef4444', text: '#ffffff', border: '#dc2626' };
    }

    function getEpisodeMeta(season, ep) {
      return SIMPSONS_DATA.find(item => item.s === season && item.e === ep);
    }

    function getSeasonEpisodes(season) {
      return SIMPSONS_DATA.filter(item => item.s === season);
    }

    function initSeasonDropdown() {
      const seasonSelect = document.getElementById('select-season');
      seasonSelect.innerHTML = '';
      for (let s = 1; s <= 12; s++) {
        const opt = document.createElement('option');
        opt.value = s;
        opt.textContent = `Season ${s}`;
        seasonSelect.appendChild(opt);
      }
      seasonSelect.value = currentSeason;
    }

    function updateEpisodeDropdown() {
      const epSelect = document.getElementById('select-episode');
      const eps = getSeasonEpisodes(currentSeason);
      epSelect.innerHTML = '';
      
      document.getElementById('season-ep-count-hint').textContent = `${eps.length} episodes`;

      eps.forEach(item => {
        const opt = document.createElement('option');
        opt.value = item.e;
        const key = `${item.s}_${item.e}`;
        const isRated = Boolean(userRatings[key]);
        opt.textContent = `Ep ${item.e}: ${item.title}${isRated ? ' ★' : ''}`;
        epSelect.appendChild(opt);
      });

      if (currentEpisode > eps.length) {
        currentEpisode = 1;
      }
      epSelect.value = currentEpisode;
      renderCurrentEpisodeCard();
    }

    function onSeasonChange() {
      currentSeason = parseInt(document.getElementById('select-season').value, 10);
      currentEpisode = 1;
      updateEpisodeDropdown();
      updateSeasonProgressBar();
    }

    function onEpisodeChange() {
      currentEpisode = parseInt(document.getElementById('select-episode').value, 10);
      renderCurrentEpisodeCard();
    }

    function navEpisode(direction) {
      const eps = getSeasonEpisodes(currentSeason);
      let targetEp = currentEpisode + direction;
      
      if (targetEp > eps.length) {
        if (currentSeason < 12) {
          currentSeason++;
          document.getElementById('select-season').value = currentSeason;
          updateEpisodeDropdown();
          targetEp = 1;
        } else {
          showToast('Reached the end of Season 12!');
          return;
        }
      } else if (targetEp < 1) {
        if (currentSeason > 1) {
          currentSeason--;
          document.getElementById('select-season').value = currentSeason;
          updateEpisodeDropdown();
          targetEp = getSeasonEpisodes(currentSeason).length;
        } else {
          showToast('Already at Season 1 Episode 1!');
          return;
        }
      }
      
      currentEpisode = targetEp;
      document.getElementById('select-episode').value = currentEpisode;
      renderCurrentEpisodeCard();
      updateSeasonProgressBar();
    }

    function renderCurrentEpisodeCard() {
      const meta = getEpisodeMeta(currentSeason, currentEpisode);
      if (!meta) return;

      document.getElementById('preview-tag').textContent = `Season ${meta.s} • Episode ${meta.e}`;
      document.getElementById('preview-title').textContent = meta.title;

      const key = `${meta.s}_${meta.e}`;
      const rating = userRatings[key];

      const badge = document.getElementById('current-rating-badge');
      const qSlider = document.getElementById('slider-quality');
      const hSlider = document.getElementById('slider-hilarity');
      const deleteBtn = document.getElementById('btn-delete-rating');

      if (rating) {
        badge.textContent = `Rated: Quality ${rating.quality} / Hilarity ${rating.hilarity}`;
        badge.className = 'px-3 py-1 rounded-full text-xs font-black border border-emerald-500 bg-emerald-50 text-emerald-800 shadow-sm';
        qSlider.value = rating.quality;
        hSlider.value = rating.hilarity;
        deleteBtn.classList.remove('hidden');
      } else {
        badge.textContent = 'Not Rated';
        badge.className = 'px-3 py-1 rounded-full text-xs font-bold border border-gray-300 bg-gray-100 text-gray-600';
        // Default clean neutral integer (7)
        qSlider.value = 7;
        hSlider.value = 7;
        deleteBtn.classList.add('hidden');
      }

      onQualitySliderInput(qSlider.value);
      onHilaritySliderInput(hSlider.value);
      updateSeasonProgressBar();
    }

    function onQualitySliderInput(val) {
      const intVal = parseInt(val, 10);
      const badge = document.getElementById('badge-quality-val');
      badge.textContent = intVal;
      
      const colors = getRatingColorTokens(intVal);
      badge.style.backgroundColor = colors.bg;
      badge.style.color = colors.text;
    }

    function onHilaritySliderInput(val) {
      const intVal = parseInt(val, 10);
      const badge = document.getElementById('badge-hilarity-val');
      badge.textContent = intVal;
      
      const colors = getRatingColorTokens(intVal);
      badge.style.backgroundColor = colors.bg;
      badge.style.color = colors.text;
    }

    function updateSeasonProgressBar() {
      const eps = getSeasonEpisodes(currentSeason);
      let ratedCount = 0;
      eps.forEach(ep => {
        if (userRatings[`${ep.s}_${ep.e}`]) ratedCount++;
      });
      const pct = (ratedCount / eps.length) * 100;
      document.getElementById('season-progress-label').textContent = `${ratedCount} / ${eps.length} rated`;
      document.getElementById('season-progress-bar').style.width = `${pct}%`;
    }

    function saveCurrentRating() {
      const q = parseInt(document.getElementById('slider-quality').value, 10);
      const h = parseInt(document.getElementById('slider-hilarity').value, 10);
      const key = `${currentSeason}_${currentEpisode}`;

      userRatings[key] = {
        quality: q,
        hilarity: h
      };

      saveRatingsToStorage();
      updateEpisodeDropdown();
      renderCurrentEpisodeCard();
      updateGlobalStats();
      buildGridTable();
      showToast(`Saved S${currentSeason}E${currentEpisode}: Quality ${q} • Hilarity ${h}`);
    }

    function clearCurrentRating() {
      const key = `${currentSeason}_${currentEpisode}`;
      if (userRatings[key]) {
        delete userRatings[key];
        saveRatingsToStorage();
        updateEpisodeDropdown();
        renderCurrentEpisodeCard();
        updateGlobalStats();
        buildGridTable();
        showToast(`Rating cleared for S${currentSeason}E${currentEpisode}`);
      }
    }

    function viewInChart() {
      switchTab('chart');
      setTimeout(() => {
        const cell = document.getElementById(`cell-${currentSeason}-${currentEpisode}`);
        if (cell) {
          cell.scrollIntoView({ behavior: 'smooth', block: 'center', inline: 'center' });
          cell.classList.add('ring-4', 'ring-black', 'scale-110');
          setTimeout(() => cell.classList.remove('ring-4', 'ring-black', 'scale-110'), 1500);
        }
      }, 150);
    }

    function buildGridTable() {
      buildSeasonAverageBadges();
      const tbody = document.getElementById('grid-episodes-body');
      tbody.innerHTML = '';

      // Up to 25 episodes in a season
      for (let epNum = 1; epNum <= 25; epNum++) {
        const row = document.createElement('div');
        row.className = 'flex items-center hover:bg-yellow-100/50 rounded transition-colors';

        // Episode number Y-axis label
        const epLabel = document.createElement('div');
        epLabel.className = 'w-16 flex-shrink-0 text-center font-black text-xs text-gray-900 border-r-2 border-black/30 pr-2';
        epLabel.textContent = epNum;
        row.appendChild(epLabel);

        // 12 Season columns
        const colsGrid = document.createElement('div');
        colsGrid.className = 'grid grid-cols-12 flex-1 gap-1';

        for (let sNum = 1; sNum <= 12; sNum++) {
          const epData = getEpisodeMeta(sNum, epNum);
          const cell = document.createElement('div');
          cell.id = `cell-${sNum}-${epNum}`;

          if (!epData) {
            // Episode does not exist in this season
            cell.className = 'h-11 rounded border border-transparent bg-yellow-300/30 opacity-30 cursor-default';
          } else {
            // Episode exists
            const ratingKey = `${sNum}_${epNum}`;
            const rating = userRatings[ratingKey];
            cell.className = 'h-11 rounded border border-black/70 shadow-sm cursor-pointer transition-all duration-150 transform hover:scale-105 hover:z-20 relative overflow-hidden select-none';
            
            renderCellContent(cell, epData, rating);

            // Jump to Tab 1 on click
            cell.onclick = () => {
              currentSeason = sNum;
              currentEpisode = epNum;
              document.getElementById('select-season').value = currentSeason;
              updateEpisodeDropdown();
              switchTab('entry');
            };

            // Floating Tooltip
            cell.onmouseenter = (e) => showTooltip(e, epData, rating);
            cell.onmousemove = (e) => moveTooltip(e);
            cell.onmouseleave = hideTooltip;
          }

          colsGrid.appendChild(cell);
        }

        row.appendChild(colsGrid);
        tbody.appendChild(row);
      }
    }

    function renderCellContent(cell, epData, rating) {
      cell.innerHTML = '';
      
      if (!rating) {
        // Unrated: clean light grey cell
        cell.className += ' bg-slate-100 hover:bg-white text-gray-400 flex items-center justify-center font-bold text-xs';
        cell.innerHTML = `<span class="opacity-40">-</span>`;
        return;
      }

      const qVal = rating.quality;
      const hVal = rating.hilarity;
      const qColor = getRatingColorTokens(qVal);
      const hColor = getRatingColorTokens(hVal);

      if (chartDisplayMode === 'split') {
        // Top half Quality, Bottom half Hilarity
        cell.className += ' flex flex-col';
        cell.innerHTML = `
          <div class="h-1/2 w-full flex items-center justify-between px-1.5 text-[10px] font-black border-b border-black/30" style="background-color: ${qColor.bg}; color: ${qColor.text};">
            <span class="opacity-80 text-[8px]">Q</span>
            <span>${qVal}</span>
          </div>
          <div class="h-1/2 w-full flex items-center justify-between px-1.5 text-[10px] font-black" style="background-color: ${hColor.bg}; color: ${hColor.text};">
            <span class="opacity-80 text-[8px]">H</span>
            <span>${hVal}</span>
          </div>
        `;
      } else if (chartDisplayMode === 'diagonal') {
        // Diagonal Split using CSS polygon clip path
        cell.className += ' diagonal-cell';
        cell.innerHTML = `
          <div class="top-left flex items-start justify-start p-1" style="background-color: ${qColor.bg}; color: ${qColor.text};">
            <span class="text-[9px] font-black leading-none">${qVal}</span>
          </div>
          <div class="bottom-right flex items-end justify-end p-1" style="background-color: ${hColor.bg}; color: ${hColor.text};">
            <span class="text-[9px] font-black leading-none">${hVal}</span>
          </div>
        `;
      } else if (chartDisplayMode === 'quality') {
        cell.style.backgroundColor = qColor.bg;
        cell.style.color = qColor.text;
        cell.className += ' flex items-center justify-center font-black text-xs';
        cell.textContent = qVal;
      } else if (chartDisplayMode === 'hilarity') {
        cell.style.backgroundColor = hColor.bg;
        cell.style.color = hColor.text;
        cell.className += ' flex items-center justify-center font-black text-xs';
        cell.textContent = hVal;
      }
    }

    function buildSeasonAverageBadges() {
      const container = document.getElementById('season-avg-circles-row');
      container.innerHTML = '';

      for (let s = 1; s <= 12; s++) {
        const eps = getSeasonEpisodes(s);
        let qSum = 0;
        let hSum = 0;
        let ratedCount = 0;

        eps.forEach(ep => {
          const r = userRatings[`${s}_${ep.e}`];
          if (r) {
            qSum += r.quality;
            hSum += r.hilarity;
            ratedCount++;
          }
        });

        const badgeWrapper = document.createElement('div');
        badgeWrapper.className = 'flex flex-col items-center justify-end';

        if (ratedCount === 0) {
          // Strictly show "-" when no episodes in this season are rated yet
          badgeWrapper.innerHTML = `
            <div class="w-10 h-10 rounded-full border-2 border-dashed border-gray-500 bg-white/70 flex flex-col items-center justify-center font-black text-xs text-gray-400 shadow-sm" 
                 title="Season ${s}: No episodes rated yet">
              <span class="text-[9px] leading-tight text-gray-500">S${s}</span>
              <span class="text-[11px] leading-tight">-</span>
            </div>
          `;
        } else {
          // Average strictly computed from user entered ratings
          const avgScore = (qSum + hSum) / (ratedCount * 2);
          const colors = getRatingColorTokens(Math.round(avgScore));
          badgeWrapper.innerHTML = `
            <div class="w-10 h-10 rounded-full border-2 border-black flex flex-col items-center justify-center font-black shadow-md text-xs transition-transform hover:scale-110 cursor-pointer" 
                 style="background-color: ${colors.bg}; color: ${colors.text};" 
                 title="Season ${s} Average (${ratedCount}/${eps.length} rated)\nQuality Avg: ${(qSum/ratedCount).toFixed(1)}\nHilarity Avg: ${(hSum/ratedCount).toFixed(1)}">
              <span class="text-[8px] leading-tight opacity-75">S${s}</span>
              <span class="text-[10px] leading-tight font-extrabold">${avgScore.toFixed(1)}</span>
            </div>
          `;
        }
        container.appendChild(badgeWrapper);
      }
    }

    function setChartDisplayMode(mode) {
      chartDisplayMode = mode;
      ['split', 'diagonal', 'quality', 'hilarity'].forEach(m => {
        const btn = document.getElementById(`mode-btn-${m}`);
        if (!btn) return;
        if (m === mode) {
          btn.className = 'px-3 py-1.5 rounded-lg text-xs font-black bg-white text-gray-900 shadow-sm border border-gray-300 transition-all';
        } else {
          btn.className = 'px-3 py-1.5 rounded-lg text-xs font-bold text-gray-600 hover:text-gray-900 transition-all';
        }
      });
      buildGridTable();
    }

    const tooltip = document.getElementById('chart-tooltip');

    function showTooltip(e, epData, rating) {
      document.getElementById('tt-title').textContent = epData.title;
      document.getElementById('tt-code').textContent = `Season ${epData.s} • Episode ${epData.e}`;
      
      const qEl = document.getElementById('tt-quality');
      const hEl = document.getElementById('tt-hilarity');

      if (rating) {
        qEl.textContent = rating.quality;
        hEl.textContent = rating.hilarity;
      } else {
        qEl.textContent = 'Unrated';
        hEl.textContent = 'Unrated';
      }

      tooltip.classList.remove('hidden');
      moveTooltip(e);
    }

    function moveTooltip(e) {
      const padding = 15;
      let x = e.clientX + padding;
      let y = e.clientY + padding;

      if (x + 200 > window.innerWidth) {
        x = e.clientX - 210;
      }
      if (y + 110 > window.innerHeight) {
        y = e.clientY - 120;
      }

      tooltip.style.left = `${x}px`;
      tooltip.style.top = `${y}px`;
    }

    function hideTooltip() {
      tooltip.classList.add('hidden');
    }

    function updateGlobalStats() {
      const totalEpisodes = SIMPSONS_DATA.length; // 269
      const ratedKeys = Object.keys(userRatings);
      const count = ratedKeys.length;

      document.getElementById('stat-rated-count').textContent = `${count} / ${totalEpisodes}`;

      if (count === 0) {
        document.getElementById('stat-avg-quality').textContent = '-';
        document.getElementById('stat-avg-hilarity').textContent = '-';
        return;
      }

      let qSum = 0;
      let hSum = 0;
      ratedKeys.forEach(k => {
        qSum += userRatings[k].quality;
        hSum += userRatings[k].hilarity;
      });

      document.getElementById('stat-avg-quality').textContent = (qSum / count).toFixed(1);
      document.getElementById('stat-avg-hilarity').textContent = (hSum / count).toFixed(1);
    }

    function showToast(msg, icon = '🍩') {
      const toast = document.getElementById('toast');
      document.getElementById('toast-msg').textContent = msg;
      document.getElementById('toast-icon').textContent = icon;
      toast.classList.remove('translate-y-24', 'opacity-0');
      setTimeout(() => {
        toast.classList.add('translate-y-24', 'opacity-0');
      }, 2400);
    }

    function exportCSV() {
      let csvContent = "Season,Episode,Title,Quality,Hilarity\n";

      SIMPSONS_DATA.forEach(ep => {
        const key = `${ep.s}_${ep.e}`;
        const rating = userRatings[key];
        const q = rating ? rating.quality : "";
        const h = rating ? rating.hilarity : "";
        const cleanTitle = `"${ep.title.replace(/"/g, '""')}"`;
        csvContent += `${ep.s},${ep.e},${cleanTitle},${q},${h}\n`;
      });

      const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement("a");
      link.setAttribute("href", url);
      link.setAttribute("download", `simpsons_ratings_seasons_1_to_12.csv`);
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      showToast("CSV exported successfully!");
    }

    function importCSV(e) {
      const file = e.target.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = function(evt) {
        try {
          const text = evt.target.result;
          const lines = text.split(/\r\n|\n/);
          let importedCount = 0;

          lines.forEach((line, idx) => {
            if (idx === 0 || !line.trim()) return; // Skip header

            // Parse quoted CSV fields accurately
            const parts = line.match(/(".*?"|[^",\s]+)(?=\s*,|\s*$)/g) || line.split(',');
            if (parts.length >= 5) {
              const s = parseInt(parts[0].replace(/"/g, ''), 10);
              const ep = parseInt(parts[1].replace(/"/g, ''), 10);
              const qStr = parts[3].replace(/"/g, '').trim();
              const hStr = parts[4].replace(/"/g, '').trim();

              if (!isNaN(s) && !isNaN(ep) && qStr !== "" && hStr !== "") {
                const q = Math.round(parseInt(qStr, 10));
                const h = Math.round(parseInt(hStr, 10));
                if (!isNaN(q) && !isNaN(h) && q >= 1 && q <= 10 && h >= 1 && h <= 10) {
                  userRatings[`${s}_${ep}`] = { quality: q, hilarity: h };
                  importedCount++;
                }
              }
            }
          });

          saveRatingsToStorage();
          updateEpisodeDropdown();
          renderCurrentEpisodeCard();
          updateGlobalStats();
          buildGridTable();
          showToast(`Imported ${importedCount} ratings!`, '✅');
        } catch (err) {
          console.error("CSV import error:", err);
          showToast("Failed to parse CSV file.", '❌');
        }
        e.target.value = '';
      };
      reader.readAsText(file);
    }

    function promptClearAllRatings() {
      openModal(
        '🗑 Reset All Ratings?',
        'Are you sure you want to delete all saved episode ratings? You can export your CSV first if you wish to keep a backup.',
        'Reset Ratings',
        () => {
          userRatings = {};
          saveRatingsToStorage();
          updateEpisodeDropdown();
          renderCurrentEpisodeCard();
          updateGlobalStats();
          buildGridTable();
          showToast('All episode ratings have been reset.', '🗑');
        }
      );
    }

    function openModal(title, desc, confirmText, onConfirm) {
      const modal = document.getElementById('custom-modal');
      document.getElementById('modal-title').textContent = title;
      document.getElementById('modal-desc').textContent = desc;
      const confirmBtn = document.getElementById('modal-btn-confirm');
      confirmBtn.textContent = confirmText;

      confirmBtn.onclick = () => {
        modal.classList.add('hidden');
        onConfirm();
      };
      document.getElementById('modal-btn-cancel').onclick = () => {
        modal.classList.add('hidden');
      };
      modal.classList.remove('hidden');
    }

    function switchTab(tab) {
      const entryView = document.getElementById('view-entry');
      const chartView = document.getElementById('view-chart');
      const entryBtn = document.getElementById('tab-btn-entry');
      const chartBtn = document.getElementById('tab-btn-chart');

      if (tab === 'entry') {
        entryView.classList.remove('hidden');
        chartView.classList.add('hidden');
        entryBtn.className = 'flex items-center gap-2 px-5 py-2.5 rounded-t-xl font-bold text-sm sm:text-base border-2 border-b-0 border-black transition-all bg-white text-black shadow-md -mb-[2px] relative z-10';
        chartBtn.className = 'flex items-center gap-2 px-5 py-2.5 rounded-t-xl font-bold text-sm sm:text-base border-2 border-b-0 border-black/40 transition-all bg-amber-200/70 hover:bg-white/70 text-gray-700 -mb-[2px]';
        renderCurrentEpisodeCard();
      } else {
        entryView.classList.add('hidden');
        chartView.classList.remove('hidden');
        chartBtn.className = 'flex items-center gap-2 px-5 py-2.5 rounded-t-xl font-bold text-sm sm:text-base border-2 border-b-0 border-black transition-all bg-white text-black shadow-md -mb-[2px] relative z-10';
        entryBtn.className = 'flex items-center gap-2 px-5 py-2.5 rounded-t-xl font-bold text-sm sm:text-base border-2 border-b-0 border-black/40 transition-all bg-amber-200/70 hover:bg-white/70 text-gray-700 -mb-[2px]';
        buildGridTable();
      }
    }

    window.addEventListener('DOMContentLoaded', () => {
      loadRatingsFromStorage();
      initSeasonDropdown();
      updateEpisodeDropdown();
      updateGlobalStats();
      buildGridTable();
    });
  </script>
</body>
